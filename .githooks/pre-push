#!/usr/bin/env bash
# Static checks for the reusable workflows, run before anything leaves the
# machine. There is no build in this repo and a reusable workflow cannot be
# invoked from a local checkout — `uses:` only resolves through GitHub — so
# without this the first feedback on a mistake is a failed run in someone
# else's repo, and for two of the checked failure modes that run has zero jobs,
# no logs and no annotation.
#
# Five independent checks. Each probes for its OWN dependencies and skips only
# itself: an earlier bare exit on a missing PyYAML used to take the whole hook
# with it, which would have meant the check CLAUDE.md calls mandatory was the
# one a missing unrelated dependency silently dropped.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass deliberately:     git push --no-verify
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

failed=0

# --- 1. workflow contract checks (python3 + PyYAML) ------------------------
if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-push: python3 not found — skipping workflow checks" >&2
elif ! python3 -c 'import yaml' 2>/dev/null; then
  echo "pre-push: PyYAML not installed — skipping workflow checks" >&2
  echo "pre-push: install it with 'pip install --user pyyaml' to enable them" >&2
else
  echo "pre-push: checking workflows"
  # CHECK_PNPM_BOOTSTRAP: also read pnpm/action-setup bootstrap lockfiles at
  # the pinned SHA and confirm the pnpm-version default still equals them.
  # PNPM_BOOTSTRAP_SOFT: an unreachable lockfile is a note here rather than a
  # refusal, so a push with no network is not blocked by a check that never
  # disagreed with anything. A real MISMATCH is still hard, soft or not.
  #
  # This hook is the ONLY place that opts out. The script is strict by default
  # precisely so the gate in CI cannot lose its strictness by omission, which
  # is what an ambient-CI switch would have allowed.
  if ! CHECK_PNPM_BOOTSTRAP=1 PNPM_BOOTSTRAP_SOFT=1 python3 scripts/check-workflows.py; then
    echo >&2
    echo "pre-push: workflow checks failed — push aborted." >&2
    echo "pre-push: these break every caller, so fix before pushing." >&2
    failed=1
  fi
fi

# --- 2. bump-token guard suite (python3 + jq) ------------------------------
# CLAUDE.md calls this mandatory before pushing a change to the guard, and for
# a while nothing local enforced it — the one check declared non-optional was
# the one the hook did not run. `guard-tests.yml` catches it in CI either way;
# this makes the failure arrive before the push rather than after it.
#
# Runs on every push, not only when the guard changed: the suite re-extracts
# the block from the shipped YAML on each run, so it is the cheap way to catch
# an edit that moved the slice markers from anywhere else in the tree.
if [ ! -f tests/guard/all.sh ]; then
  : # suite absent on this ref (e.g. pushing an older branch) — nothing to run
elif ! command -v python3 >/dev/null 2>&1; then
  echo "pre-push: python3 not found — skipping guard suite" >&2
elif ! command -v jq >/dev/null 2>&1; then
  echo "pre-push: jq not found — skipping guard suite" >&2
  echo "pre-push: install it with 'sudo apt-get install -y jq' to enable it" >&2
else
  echo "pre-push: running the bump-token guard suite"
  if ! bash tests/guard/all.sh; then
    echo >&2
    echo "pre-push: guard suite failed — push aborted." >&2
    echo "pre-push: this guard runs on the one path with no retry, where a" >&2
    echo "pre-push: nonzero exit after the merge costs the release tag." >&2
    failed=1
  fi
fi

# --- 3. pnpm-version guard suite (python3) ---------------------------------
# Same reasoning as the suite above, and the same "runs on every push" rule:
# its extractor re-slices the block out of all three workflows and refuses
# unless they are byte-identical, so it catches a copy drifting out of lockstep
# no matter which file the push touched. No jq: the guard under test is pure
# shell, though extract.sh slices it out with a python3 heredoc -- which is why
# the probe below tests python3 and not jq.
if [ ! -f tests/pnpm-guard/run.sh ]; then
  : # suite absent on this ref -- nothing to run
elif ! command -v python3 >/dev/null 2>&1; then
  echo "pre-push: python3 not found -- skipping pnpm-version guard suite" >&2
else
  echo "pre-push: running the pnpm-version guard suite"
  if ! bash tests/pnpm-guard/run.sh; then
    echo >&2
    echo "pre-push: pnpm-version guard suite failed -- push aborted." >&2
    echo "pre-push: this guard is what keeps a caller off a pnpm the pinned" >&2
    echo "pre-push: action does not bootstrap, and its warn branch exits 0 --" >&2
    echo "pre-push: a mistake there is green until it reaches a shared store." >&2
    failed=1
  fi
fi

# --- 4. fixture cases for check-workflows.py itself ------------------------
# Check 1 runs the script; this runs its assertions against fixtures. Both are
# needed: check 1 proves the tree is clean, this proves the script would still
# say so if it were not. A regex that quietly stops matching passes check 1.
if [ ! -f tests/check-workflows/run.py ]; then
  : # suite absent on this ref -- nothing to run
elif ! command -v python3 >/dev/null 2>&1; then
  echo "pre-push: python3 not found -- skipping workflow-check fixtures" >&2
elif ! python3 -c 'import yaml' 2>/dev/null; then
  echo "pre-push: PyYAML not installed -- skipping workflow-check fixtures" >&2
else
  echo "pre-push: running the workflow-check fixtures"
  if ! python3 tests/check-workflows/run.py; then
    echo >&2
    echo "pre-push: workflow-check fixtures failed -- push aborted." >&2
    echo "pre-push: these assertions gate every caller from the one required" >&2
    echo "pre-push: check on main, so a false positive reds the whole repo." >&2
    failed=1
  fi
fi

# --- 5. workflow lint (actionlint + shellcheck) ----------------------------
# Same gate CI runs in the `guard` job. Locally it uses whatever actionlint is
# installed, while CI pins a version — so a skew surfaces as a CI-only finding.
# Bump the local binary rather than suppressing it.
#
# The shellcheck binary is probed SEPARATELY and on purpose: actionlint drops
# every shell check when it cannot find shellcheck and still exits 0, so
# without this probe a clean run here would mean nothing.
if ! command -v actionlint >/dev/null 2>&1; then
  echo "pre-push: actionlint not found — skipping workflow lint" >&2
  echo "pre-push: install it from https://github.com/rhysd/actionlint/releases to enable it" >&2
elif ! command -v shellcheck >/dev/null 2>&1; then
  echo "pre-push: shellcheck not found — skipping workflow lint" >&2
  echo "pre-push: actionlint without it exits 0 over unchecked shell, so this skips rather than lying" >&2
  echo "pre-push: install it with 'sudo apt-get install -y shellcheck' to enable it" >&2
else
  echo "pre-push: linting workflows with actionlint"
  if ! actionlint; then
    echo >&2
    echo "pre-push: actionlint failed — push aborted." >&2
    echo "pre-push: fix the finding, or add a scoped '# shellcheck disable=SCxxxx'" >&2
    echo "pre-push: comment with a one-line reason if it is a false positive." >&2
    failed=1
  fi
fi

if [ "$failed" != 0 ]; then
  echo >&2
  echo "pre-push: override with 'git push --no-verify' if you are certain." >&2
  exit 1
fi
